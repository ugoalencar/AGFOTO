{
  "name": "ag-fotografia",
  "version": "1.0.0",
  "description": "Sistema de captura, QA, entrega e relatórios de fotografias de produtos e veículos",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/**/*.test.js",
    "test:unit": "node --test tests/unit/**/*.test.js",
    "test:integration": "node --test tests/integration/**/*.test.js",
    "lint": "eslint .",
    "audit:fs": "node scripts/audit-filesystem.js"
  },
  "keywords": [
    "fotografia",
    "produtos",
    "veículos",
    "QA",
    "entrega"
  ],
  "author": "AG Fotografia",
  "license": "PROPRIETARY",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "jimp": "^1.6.1",
    "playwright": "^1.62.1",
    "tesseract.js": "^7.0.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "eslint": "^8.49.0"
  }
}
